# TEMPLATE ONLY — this file is committed to git. Never put real values here.
# Copy to .env (gitignored) and fill that in instead.

# Your LeetCode handle, the one in leetcode.com/u/<this>/
LEETCODE_USERNAME=

# Optional but this is what unlocks the full reconcile.
# leetcode.com (logged in) > DevTools > Application > Cookies > LEETCODE_SESSION
# It expires every few weeks; when the sheet says the cookie was rejected, re-copy it.
LEETCODE_SESSION=

# Optional. Same cookie jar, named csrftoken. Only some endpoints care.
LEETCODE_CSRF=
